---
import Layout from "../../layouts/Layout.astro";
import BlogSection from "@/components/BlogSection.astro";
---

<Layout title="Marcin Jałocha | Blog" description="Blog posts" scrollSmooth={false}>
	<div class="flex flex-col gap-8">
		<div>
			<a href="/" class="italic text-sm text-subtle hover:text-primary transition-none mb-6 inline-block">← Back</a>
			<h1 class="text-3xl font-serif text-fg">Blog</h1>
			<p class="text-base text-fg-dim leading-relaxed max-w-xl border-l-2 border-primary pl-4 mt-4">
				A small corner where I put my thoughts, experiences and feelings on all kinds of topics out in the open.
				<span class="italic text-subtle">Viewer discretion is advised.</span>
			</p>
		</div>
		<BlogSection />
	</div>
</Layout>
